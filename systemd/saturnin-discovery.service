[Unit]
Description=Saturnin discovery - adopt issues from managed repositories
Documentation=file://@SATURNIN_HOME@/docs/observability.md

[Service]
Type=oneshot
WorkingDirectory=@SATURNIN_HOME@
Environment=SATURNIN_HOME="@SATURNIN_HOME_ENV@"
ExecStart=@SATURNIN_HOME@/automation/library/discover_issues.sh
Nice=10
