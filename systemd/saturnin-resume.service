[Unit]
Description=Saturnin delayed checkpoint resume sweep
Documentation=file://@SATURNIN_HOME@/docs/runbooks/checkpoint-handoff.md

[Service]
Type=oneshot
PrivateMounts=yes
WorkingDirectory=@SATURNIN_HOME@
Environment=SATURNIN_HOME="@SATURNIN_HOME_ENV@"
ExecStart=@SATURNIN_HOME@/automation/library/resume_checkpoints.sh
Nice=10
