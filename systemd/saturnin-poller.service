[Unit]
Description=Saturnin result poller - collects results so the CEO never waits
Documentation=file://@SATURNIN_HOME@/docs/operating-model.md

[Service]
Type=oneshot
WorkingDirectory=@SATURNIN_HOME@
Environment=SATURNIN_HOME="@SATURNIN_HOME_ENV@"
EnvironmentFile=-@SATURNIN_HOME@/var/secrets/review-attestation.env
ExecStart=@SATURNIN_HOME@/automation/library/result_poller.sh
Nice=10
